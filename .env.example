# Google Places (venue suggestions in Create meeting). Needs the Maps JavaScript API and the Places API enabled for the key.
# Restrict the key to your website addresses in Google Cloud. Empty = the venue is a plain text box.
VITE_GOOGLE_MAPS_API_KEY=

# --- Member API (leave VITE_API_URL empty to run the stand-alone prototype on sample data) ---------------------------
# Deployed builds should NOT set these: put the values in public/config.js (copied next to index.html) so one build serves
# every client and changing the API address needs no rebuild. VITE_API_URL is only the fallback when config.js is empty.
# The member API root, e.g. https://api.example.com/api  (local: http://127.0.0.1:8001/api)
VITE_API_URL=
# Which client this build serves. Empty = the address the page is opened from (the client's own domain).
# While testing on another address you can also open the site once with ?tenant=<client domain>.
VITE_TENANT_HOST=
